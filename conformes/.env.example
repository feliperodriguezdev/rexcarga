# Copia este archivo a .env y complétalo (no subas .env al repositorio)

# --- Envío de correo ---
# Hay dos transportes. Si RESEND_API_KEY tiene valor se envía por HTTPS
# (obligatorio en Render: el plan gratuito bloquea los puertos de SMTP).
# Si está vacía, se usa Gmail SMTP, que sirve para desarrollo local.

# PRODUCCIÓN: clave de https://resend.com y remitente de un dominio verificado allí
RESEND_API_KEY=
MAIL_FROM=conformes@sudominio.com

# LOCAL: cuenta Gmail dedicada que envía los correos
GMAIL_USER=actas.transportexyz@gmail.com
# App password de 16 caracteres (Cuenta Google > Seguridad > Contraseñas de aplicaciones)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Correo fijo del gerente (siempre recibe copia)
MANAGER_EMAIL=gerente@laempresa.com

# Nombre del cliente (aparece en el PDF y en el asunto)
COMPANY_NAME=Transportes XYZ

# Opcional: ruta a un PNG con el logo del cliente. Por defecto app/static/logo.png
# LOGO_PATH=app/static/logo.png

# Opcional
TIMEZONE=America/Bogota
